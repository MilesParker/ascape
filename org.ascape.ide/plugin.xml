<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>

<plugin>
<extension point="org.eclipse.ui.newWizards">
   <wizard
         class="org.ascape.ide.AscapeJavaPluginProjectWizard"
         descriptionImage="icons/AscapeLogo.png"
         icon="icons/Ascape16.png"
         id="org.ascape.wizards.newProject"
         name="Ascape (Swing AWT) Project"
         project="true">
      <description>
         Creates a new &quot;plain old java&quot; project for Escape models.
      </description>
   </wizard>
	</extension>
<extension
      point="org.eclipse.ui.perspectiveExtensions">
   <perspectiveExtension
         targetID="org.eclipse.jdt.ui.JavaPerspective">
      <newWizardShortcut
            id="org.ascape.wizards.newProject">
      </newWizardShortcut>
   </perspectiveExtension>
</extension>
<extension
      point="org.eclipse.ui.perspectiveExtensions">
   <perspectiveExtension
         targetID="org.eclipse.amp.amf.AgentModelingPerspective">
      <newWizardShortcut
            id="org.ascape.wizards.newProject">
      </newWizardShortcut>
   </perspectiveExtension>
</extension>
</plugin>
