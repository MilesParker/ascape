<?xml version="1.0"?>
<!DOCTYPE project PUBLIC "-//ANT//DTD project//EN" "project.dtd" [
        ]>

<project name="buildTargets" default="build">

	<target name="prepare" description="initializes some useful variables">
		<tstamp>
			<format property="year" pattern="yyyy" />
		</tstamp>
		<filterset id="filters">
			<filter token="VERSION" value="${Name} -- ${DSTAMP}" />
			<filter token="TODAY" value="${TODAY}" />
			<filter token="DSTAMP" value="${DSTAMP}" />
			<filter token="TSTAMP" value="${TSTAMP}" />
		</filterset>
	</target>

	<target name="manifest" depends="prepare" description="creates the manifest">
		<mkdir dir="${dir.releaseClasses}" />
		<echo file="${manifest.file}">Manifest-Version: 1.0
            Created-By: org.ascape on ${TODAY} at ${TSTAMP}
            Main-Class: ${manifest.main.class}
            Class-Path: ${manifest.class.path}
        </echo>
	</target>

	<target name="clean" description="removes all files generated by build" unless="build.clean">
		<delete>
			<fileset dir="${dir.bin}" includes="**/*.class" />
			<fileset dir="${dir.bin}" includes="**/*.jar" />
		</delete>
		<echo>$$$$$$$$$$$$$$$$$$$$</echo>
		<delete dir="${dir.reports}" />
		<delete file="${name}.jar" />
	</target>

	<target name="realclean" depends="clean" description="removes everything from project root">

		<p4revert view="${perforce.view}" />
		<p4sync view="${perforce.view}#none" />

	</target>

	<!--
    ===================================================================
    Building Targets
    ===================================================================
    -->

	<target name="sync" depends="prepare" description="synchronizes with the latest version of code" unless="build.local">
		<p4sync view="${perforce.view}" />
	</target>

	<target name="compile" description="compiles the source code">
		<mkdir dir="${dir.bin}" />
		<javac srcdir="${dir.src}" destdir="${dir.bin}" includes="${dir.includes}" excludes="${dir.excludes}" classpath="${dir.classpath}" debug="${javac.debug}" deprecation="${javac.deprecation}" optimize="${javac.optimize}" verbose="false" source="1.5">
		</javac>
	</target>

	<target name="copyres" description="copies resources to the build dir">
		<mkdir dir="${dir.bin}" />
		<copy todir="${dir.bin}">
			<fileset dir="${dir.res}">
			</fileset>
		</copy>
	</target>

	<target name="copyjars" description="copies jar dependencies to the build dir">
		<mkdir dir="${dir.bin}" />
		<copy todir="${dir.bin}">
			<fileset dir="${dir.lib}" includes="${dir.ascape.jars.includes}" />
		</copy>
	</target>

	<target name="build" depends="clean, copyres, compile, test" description="syncs, compiles, tests the class files for the project" />

	<!--
    ===================================================================
    Run-time Targets
    ===================================================================
    -->

	<target name="run" description="just runs" depends="compile">
		<java classname="${manifest.main.class}" classpath="${dir.classpath}" fork="yes" dir="${dir.classes}" />
	</target>

	<!--
    ===================================================================
    Testing Targets
    ===================================================================
    -->

	<target name="test" description="runs tests for the project" if="test.main.class">
		<mkdir dir="${dir.reports}" />
		<mkdir dir="${dir.work}" />
		<junit printsummary="yes" haltonfailure="yes" fork="on" maxmemory="200m" dir="${dir.work}">

			<classpath>
				<pathelement path="${dir.classpath}" />
			</classpath>

			<test name="${test.main.class}" todir="${dir.reports}">
				<formatter type="plain" usefile="no" />
			</test>

		</junit>
	</target>

	<target name="jar" depends="manifest" description="generates jar file for all dir.classes.">
		<jar jarfile="${dir.classes}/${Name}.jar" basedir="${dir.classes}" includes="${dir.includes}" excludes="**/MANIFEST.MF *.jar" manifest="${manifest.file}">
		</jar>
	</target>

	<target name="project.dtd" description="creates a dtd for ant build.xml files">
		<antstructure output="project.dtd" />
	</target>

	<!--
    ===================================================================
    Documentation Targets
    ===================================================================
    -->

	<target name="javadoc" description="creates javadoc for the project">
		<mkdir dir="${dir.api}" />
		<javadoc packagenames="org.*" sourcepath="${dir.javadoc.src}" destdir="${dir.api}" classpath="${dir.classpath}" author="true" group="true" verbose="false" use="true" windowtitle="${Name}">
			<header>
				<![CDATA[<img src="AscapeLogo.gif"/>]]>
			</header>
			<doctitle>
				<![CDATA[<h1>${Name}</h1>]]>
			</doctitle>
		<bottom>
			<![CDATA[<i>Copyright &#169; 1998-2007 The Brookings Institution, NuTech Solutions, Metascape, LLC  All Rights Reserved.</i>]]>
			</bottom>
</javadoc>
</target>
</project>
