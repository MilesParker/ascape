        <md:cspec name="org.ascape.site" componentType="eclipse.feature" version="5.6.0.qualifier">
            <cs:dependencies xmlns:cs="http://www.eclipse.org/buckminster/CSpec-1.0">
                <cs:dependency name="org.ascape.examples.feature" componentType="eclipse.feature"/>
