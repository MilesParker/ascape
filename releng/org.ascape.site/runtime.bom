                    <cs:attribute name="copy.plugins"/>
                </cs:public>
                <cs:public name="source.bundle.jars" filter="(!(cbi.include.source=false))">
                    <cs:attribute name="source.bundle.jars" component="org.ascape.sdk"/>
                    <cs:attribute name="source.bundle.jars" component="org.ascape.examples.feature"/>
